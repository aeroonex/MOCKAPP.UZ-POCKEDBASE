# Mockapp.uz — frontend (SPA) + API/fayllar proxy. Bitta domen ostida.
# ${API_UPSTREAM} nginx ishga tushganda envsubst bilan to'ldiriladi (default: api:4000).
# SSL tashqi reverse-proxy (Nginx Proxy Manager / Cloudflare) tomonidan tugatiladi.

map $sent_http_content_type $cache_control_for_type {
    default                      "public, max-age=3600";
    text/html                    "no-cache";
}

server {
    listen 80;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # Ortidagi proxy'dan haqiqiy IP
    set_real_ip_from 0.0.0.0/0;
    real_ip_header   X-Forwarded-For;

    gzip            on;
    gzip_vary       on;
    gzip_min_length 1024;
    gzip_types      text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml font/woff2;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /healthz {
        access_log off;
        return 200 "ok";
    }

    # ---- API (Fastify) ----
    location /api/ {
        proxy_pass         http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # Cloudflare: haqiqiy IP va davlat (nazorat paneli uchun)
        proxy_set_header   CF-Connecting-IP  $http_cf_connecting_ip;
        proxy_set_header   CF-IPCountry      $http_cf_ipcountry;

        # Katta video yuklash: 2 GB, buferlashsiz oqim
        client_max_body_size     2100m;
        proxy_request_buffering  off;
        proxy_read_timeout       3600s;
        proxy_send_timeout       3600s;
    }

    # ---- Yuklangan fayllar (video/rasm), Range qo'llab-quvvatlanadi ----
    location /files/ {
        proxy_pass         http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host  $host;
        proxy_set_header   Range $http_range;
        proxy_buffering    off;
        proxy_read_timeout 3600s;
    }

    # ---- Statik assetlar (hash nomli) — uzoq kesh ----
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # ---- SPA ----
    location / {
        add_header Cache-Control $cache_control_for_type;
        try_files $uri $uri/ /index.html;
    }
}
