# docker compose uchun muhit o'zgaruvchilari — nusxalang: cp .env.deploy.example .env.deploy
# Ishga tushirish: docker compose --env-file .env.deploy up -d --build

# --- PostgreSQL ---
POSTGRES_DB=mockapp
POSTGRES_USER=mockapp
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# --- Auth ---  (openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_EXPIRES_IN=30d

# --- Birinchi superadmin (role=developer) ---
ADMIN_EMAIL=admin@edumock.uz
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- Web konteyner tashqi porti (NPM shu portga proxy qiladi) ---
WEB_PORT=8087

# --- Ixtiyoriy ---
VITE_API_URL=
VITE_GEMINI_API_KEY=
CORS_ORIGINS=
MAX_VIDEO_BYTES=2147483648
DEFAULT_STORAGE_LIMIT_BYTES=107374182400
