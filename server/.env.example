# --- Server ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# --- PostgreSQL ---
DATABASE_URL=postgres://mockapp:CHANGE_ME_DB_PASSWORD@db:5432/mockapp

# --- Auth ---
# Kamida 32 belgili tasodifiy satr: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=30d

# --- Fayllar (video/rasm) saqlanadigan papka ---
DATA_DIR=/data

# --- Birinchi ishga tushishda yaratiladigan superadmin (role=developer) ---
ADMIN_EMAIL=admin@mockapp.uz
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- Limitlar ---
MAX_VIDEO_BYTES=2147483648
MAX_IMAGE_BYTES=5242880
DEFAULT_STORAGE_LIMIT_BYTES=107374182400

# --- CORS (vergul bilan; bir domen ostida bo'lsa bo'sh qoldiring) ---
CORS_ORIGINS=

# Saytning tashqi manzili (Telegram xabarlaridagi video havolalari uchun)
PUBLIC_BASE_URL=https://edumock.uz
# Imtihon stansiyasi manzili (cefr.* host — faqat Mock Test + Yozuvlar, tashkilotchi paroli bilan)
STATION_BASE_URL=https://cefr.edumock.uz
# Stansiya tokeni muddati (sukut 12h)
STATION_TOKEN_EXPIRES_IN=12h
